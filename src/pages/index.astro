---
import Layout from "../layouts/Layout.astro";
import BasicInfo from "../components/BasicInfo.astro";
import Experience from "../components/Experience.astro";
import Projects from "../components/Projects.astro";
import Skills from "../components/Skills.astro";
import Certificates from "../components/Certificates.astro";
---

<Layout>
  <main class="max-w-7xl m-auto pt-20 pb-24 lg:pt-28 px-8 md:px-16">
    <BasicInfo />
    <div class="flex flex-col gap-12 md:gap-24 md:flex-row">
      <Experience />
    </div>
    <Projects />
    <Skills />
    <Certificates />
  </main>
</Layout>
