---
import WhiteGradient from "../components/WhiteGradient.astro";
import NavBar from "../components/NavBar.astro";
import "../styles/global.css";
import Footer from "../components/Footer.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>EduardX</title>
  </head>
  <body class="min-h-screen bg-custom-dark text-slate-100">
    <WhiteGradient />
    <NavBar />
    <slot />
    <Footer />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100vh;
  }
</style>
