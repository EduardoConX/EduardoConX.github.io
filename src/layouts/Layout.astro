---
import WhiteGradient from "../components/WhiteGradient.astro";
import NavBar from "../components/NavBar.astro";
import "../styles/global.css";
import Footer from "../components/Footer.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Eduardo Pacheco is a full stack developer building clear, capable, and modern digital products for web and product teams."
    />
    <meta
      name="keywords"
      content="full stack developer, web development, portfolio, Astro, TypeScript, React, software engineer"
    />
    <meta property="og:title" content="Eduardo Pacheco | Full Stack Developer" />
    <meta
      property="og:description"
      content="Full stack developer building clear, capable, and modern digital products. Explore projects, experience, and skills."
    />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Eduardo Pacheco | Full Stack Developer</title>
  </head>
  <body class="min-h-screen bg-custom-dark text-slate-100">
    <WhiteGradient />
    <NavBar />
    <slot />
    <Footer />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100vh;
  }
</style>
