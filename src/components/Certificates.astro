---
import { certificates } from "../consts";
import Medal from "../icons/Medal.astro";
---

<section
  class="grid gap-12 border-t border-white/10 py-20 lg:grid-cols-[0.37fr_0.63fr]"
>
  <div>
    <p class="font-mono text-xs uppercase tracking-[0.2em] text-blue-300">
      05 / Credentials
    </p><h2 class="mt-4 text-4xl font-semibold tracking-tight text-white">
      Always learning.
    </h2>
  </div><div class="flex flex-col">
    {
      certificates.map((certificate) => (
        <div class="flex items-center justify-between gap-5 border-b border-white/10 py-5 first:pt-0">
          <div class="flex items-center gap-3">
            <Medal />
            <a href={certificate.url} target="_blank" class="text-slate-200">
              {certificate.name}
            </a>
          </div>
          <span class="shrink-0 font-mono text-xs text-slate-500">
            {certificate.date}
          </span>
        </div>
      ))
    }
  </div>
</section>
