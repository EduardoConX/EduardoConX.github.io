---
import ExperienceItem from "./ExperienceItem.astro";

const experienceList = [
  {
    startDate: "Nov 2021",
    endDate: "Present",
    title: "Software Developer",
    company: "Blue People",
    companyLink: "https://bluepeople.com",
    summary:
      "Developing custom web applications for clients across several industries, including integrations with ticket printers, label printers, and card payment terminals.",
    technologies: ["VueJS", "Node", "Express", "MySQL"],
  },
  {
    startDate: "Aug 2021",
    endDate: "Nov 2021",
    title: "Frontend Developer",
    company: "Link México",
    companyLink: "https://linkitmexico.com/",
    summary:
      "Built and maintained websites for brands including bits&birds, applab mx, and Linkit México.",
    technologies: ["VueJS"],
  },
  {
    startDate: "Jan 2020",
    endDate: "Aug 2021",
    title: "Software Developer",
    company: "DataTics",
    companyLink: "https://datatics.com.mx/",
    summary:
      "Designed and developed the company payment system with a focus on dependable workflows and maintainable interfaces.",
    technologies: ["VueJS", "PHP", "Laravel", "MySQL"],
  },
];
---

<section
  id="experience"
  class="grid gap-12 border-t border-white/10 py-20 lg:grid-cols-[0.37fr_0.63fr]"
>
  <div>
    <p class="font-mono text-xs uppercase tracking-[0.2em] text-blue-300">
      02 / Experience
    </p><h2
      class="mt-4 max-w-xs text-4xl font-semibold tracking-tight text-white"
    >
      A track record of thoughtful delivery.
    </h2>
  </div><ul class="flex flex-col gap-10">
    {
      experienceList.map((experience) => (
        <ExperienceItem experience={experience} />
      ))
    }
  </ul>
</section>
