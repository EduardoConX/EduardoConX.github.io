---
interface Props {
  technologies: string[];
}

const { technologies } = Astro.props;
---

<ul class="mt-6 flex flex-wrap gap-2">
  {
    technologies.map((technology) => (
      <li>
        <span class="rounded-full bg-white/8 px-3 py-1 text-xs text-slate-300">
          {technology}
        </span>
      </li>
    ))
  }
</ul>
