---
import { Image } from "astro:assets";
import UpRight from "../icons/UpRight.astro";
import TechnologiesList from "./TechnologiesList.astro";

interface Project {
  name: string;
  image: ImageMetadata;
  description: string;
  technologies: string[];
}

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
const indexString = (index + 1).toString().padStart(2, "0");
---

<a
  href="#contact"
  class="group overflow-hidden rounded-3xl border border-white/10 bg-white/[0.035] transition hover:-translate-y-1 hover:border-blue-400/40 hover:bg-white/6"
  ><div class="relative aspect-[1.75] overflow-hidden bg-slate-900">
    <Image
      src={project.image}
      alt={project.name}
      class="h-full w-full object-cover object-top opacity-80 transition duration-500 group-hover:scale-105 group-hover:opacity-100"
    />
    <div
      class="absolute left-5 top-5 rounded-full border border-white/15 bg-black/50 px-3 py-1 text-xs text-slate-200 backdrop-blur"
    >
      {indexString}
    </div>
  </div><div class="p-6">
    <div class="flex items-start justify-between gap-4">
      <div>
        <!-- <p class="font-mono text-xs uppercase tracking-[0.16em] text-blue-300">
          Editorial platform
        </p> -->
        <h3 class="mt-2 text-2xl font-medium text-white">{project.name}</h3>
      </div>
      <UpRight />
    </div><p class="mt-4 leading-7 text-slate-400">
      {project.description}
    </p>
    <TechnologiesList technologies={project.technologies} version="V2" />
  </div>
</a>
