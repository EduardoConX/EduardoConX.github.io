---
import TechnologiesList from "./TechnologiesList.astro";

interface Experience {
  startDate: string;
  endDate: string;
  title: string;
  company: string;
  companyLink: string;
  summary: string;
  technologies: string[];
}

interface Props {
  experience: Experience;
}

const { experience } = Astro.props;
const {
  startDate,
  endDate,
  title,
  company,
  companyLink,
  summary,
  technologies,
} = experience;
---

<li>
  <article
    class="grid gap-5 border-b border-white/10 pb-10 last:border-0 last:pb-0 sm:grid-cols-[150px_1fr]"
  >
    <p class="font-mono text-xs leading-6 text-slate-500">
      {startDate} — {endDate}
    </p><div>
      <h3 class="text-xl font-medium text-white">
        {title}
        <a href={companyLink} target="_blank">
          <span class="text-blue-400"> @{company}</span>
        </a>
      </h3><p class="mt-4 max-w-2xl leading-7 text-slate-400">
        {summary}
      </p><TechnologiesList technologies={technologies} version="V1" />
    </div>
  </article>
</li>
