---
import CodeIcon from "../icons/CodeIcon.astro";
import UpRight from "../icons/UpRight.astro";
---

<section
  id="contact"
  class="relative overflow-hidden rounded-3xl border border-blue-400/25 bg-blue-500/10 px-6 py-14 text-center sm:px-12"
>
  <div
    class="absolute inset-0 bg-[radial-gradient(circle_at_50%_0%,rgba(96,165,250,0.2),transparent_55%)]"
  >
  </div><div class="relative">
    <CodeIcon />
    <p class="mt-5 font-mono text-xs uppercase tracking-[0.2em] text-blue-200">
      06 / Contact
    </p><h2
      class="mx-auto mt-4 max-w-2xl text-4xl font-semibold tracking-tight text-white sm:text-5xl"
    >
      Have a thoughtful problem to solve?
    </h2><p class="mx-auto mt-5 max-w-lg leading-7 text-slate-300">
      I'm always interested in good products, ambitious teams, and work that
      makes the web a little better.
    </p><a
      href="mailto:eduardopachecoquintanar@gmail.com"
      class="mt-8 inline-flex items-center gap-2 rounded-full bg-white px-5 py-3 text-sm font-semibold text-slate-950 transition hover:bg-blue-100"
      >Start a conversation <UpRight />
    </a>
  </div>
</section>
