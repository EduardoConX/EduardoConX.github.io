---
interface Props {
  technologies: string[];
}

const { technologies } = Astro.props;
---

<ul class="mt-5 flex flex-wrap gap-2">
  {
    technologies.map((technology) => (
      <li>
        <span class="rounded-full border border-blue-400/25 bg-blue-400/5 px-3 py-1 text-xs text-blue-200">
          {technology}
        </span>
      </li>
    ))
  }
</ul>
