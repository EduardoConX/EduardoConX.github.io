---
import blogConX from "../assets/blogConX.png";
import pokedex from "../assets/eduardxPokedex.png";
import Project from "./Project.astro";

const projects = [
  {
    name: "Blog con X",
    url: "https://eduardoconx.github.io/blog-con-x/",
    image: blogConX,
    description:
      "Small blog where I share programming concepts that I find interesting.",
    technologies: ["Astro", "Tailwind"],
  },
  {
    name: "Pokedex",
    url: "https://eduardx-pokedex.netlify.app/",
    image: pokedex,
    description:
      "Project to keep track of the Pokémon I catch in the Discord game 'PokeTwo'",
    technologies: ["VueJS", "Tailwind", "Firebase"],
  },
];
---

<section id="work" class="border-t border-white/10 py-20">
  <div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-end">
    <div>
      <p class="font-mono text-xs uppercase tracking-[0.2em] text-blue-300">
        03 / Selected work
      </p><h2 class="mt-4 text-4xl font-semibold tracking-tight text-white">
        Things I've shipped.
      </h2>
    </div><p class="max-w-sm text-sm leading-6 text-slate-400">
      A few projects where product thinking, engineering, and a little curiosity
      meet.
    </p>
  </div><div class="mt-10 grid gap-6 lg:grid-cols-2">
    {
      projects.map((project, index) => (
        <Project project={project} index={index} />
      ))
    }
  </div>
</section>
