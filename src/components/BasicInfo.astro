---
import Mail from "../icons/Mail.astro";
import UpRight from "../icons/UpRight.astro";
import Profile from "./Profile.astro";
---

<section
  id="top"
  class="grid gap-14 pb-24 lg:grid-cols-[1.15fr_0.85fr] lg:items-end"
>
  <div>
    <div
      class="mb-7 inline-flex items-center gap-2 rounded-full border border-emerald-400/20 bg-emerald-400/5 px-3 py-1.5 text-xs font-medium text-emerald-300"
    >
      <span
        class="size-1.5 rounded-full bg-emerald-300 shadow-[0_0_12px_rgba(110,231,183,0.8)]"
      ></span> Available for select projects
    </div><p
      class="mb-5 font-mono text-sm uppercase tracking-[0.24em] text-blue-300"
    >
      Full stack developer / Mexico
    </p><h1
      class="max-w-3xl text-5xl font-semibold leading-[0.98] tracking-tighter text-white sm:text-7xl"
    >
      Building digital products that feel <span class="text-blue-400"
        >clear, capable, and alive.</span
      >
    </h1><p class="mt-8 max-w-xl text-lg leading-8 text-slate-400">
      I'm EduardoConX, a full stack developer with 5+ years of experience
      turning complex problems into simple, intuitive experiences.
    </p><div class="mt-9 flex flex-wrap gap-3">
      <a
        href="#work"
        class="inline-flex items-center gap-2 rounded-full bg-blue-500 px-5 py-3 text-sm font-semibold text-white transition hover:bg-blue-400"
        >Explore my work <UpRight /></a
      ><a
        href="mailto:eduardopachecoquintanar@gmail.com"
        class="inline-flex items-center gap-2 rounded-full border border-white/15 px-5 py-3 text-sm font-semibold text-slate-200 transition hover:border-white/35 hover:bg-white/5"
        ><Mail /> Get in touch</a
      >
    </div>
  </div><div
    class="relative rounded-3xl border border-white/10 bg-white/[0.035] p-6 shadow-2xl shadow-blue-950/20 lg:mb-2"
  >
    <Profile />
  </div>
</section>
