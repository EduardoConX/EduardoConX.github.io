---
const skills = {
  fronted: [
    "HTML",
    "CSS",
    "JavaScript",
    "TypeScript",
    "Tailwind",
    "VueJS",
    "ReactJS",
    "Astro",
  ],
  backend: ["Node", "Express", "PHP", "Laravel", "MySQL", "PostgreSQL"],
  otherTools: ["GIT"],
};
---

<section
  class="grid gap-12 border-t border-white/10 py-20 lg:grid-cols-[0.37fr_0.63fr]"
>
  <div>
    <p class="font-mono text-xs uppercase tracking-[0.2em] text-blue-300">
      04 / Toolkit
    </p><h2 class="mt-4 text-4xl font-semibold tracking-tight text-white">
      The tools behind the magic.
    </h2>
  </div><div class="grid gap-8 sm:grid-cols-3">
    <div>
      <p class="mb-4 text-sm font-medium text-white">Frontend</p><div
        class="flex flex-wrap gap-2"
      >
        {
          skills.fronted.map((frontendSkill) => (
            <span class="rounded-lg border border-white/10 px-3 py-2 text-sm text-slate-400 transition hover:border-blue-400/40 hover:text-blue-200">
              {frontendSkill}
            </span>
          ))
        }
      </div>
    </div><div>
      <p class="mb-4 text-sm font-medium text-white">Backend &amp; data</p><div
        class="flex flex-wrap gap-2"
      >
        {
          skills.backend.map((backendSkill) => (
            <span class="rounded-lg border border-white/10 px-3 py-2 text-sm text-slate-400 transition hover:border-blue-400/40 hover:text-blue-200">
              {backendSkill}
            </span>
          ))
        }
      </div>
    </div><div>
      <p class="mb-4 text-sm font-medium text-white">Other tools</p><div
        class="flex flex-wrap gap-2"
      >
        {
          skills.otherTools.map((otherSkill) => (
            <span class="rounded-lg border border-white/10 px-3 py-2 text-sm text-slate-400 transition hover:border-blue-400/40 hover:text-blue-200">
              {otherSkill}
            </span>
          ))
        }
      </div>
    </div>
  </div>
</section>
